# --- Database ---
DATABASE_URL="postgresql://dataextractor:dataextractor@localhost:5432/data_extractor?schema=public"

# --- Backend server ---
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"

# --- AI provider abstraction ---
# "mock" runs with deterministic canned responses and needs no API key (default for dev).
# Set to "anthropic", "gemini", or "openrouter" once a real key is supplied.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# AI_MODEL is provider-specific, e.g. "openai/gpt-4o-mini" for openrouter.
AI_MODEL=

# --- Browser agent ---
# Headful is required so a human can complete a CAPTCHA/OTP challenge manually when the agent pauses.
BROWSER_HEADLESS=false
# The agent drives your OWN browser over the Chrome DevTools Protocol instead of an isolated one.
# Start Chrome with:  chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\chrome-agent-profile"
# (Chrome ignores the debugging port on its default profile, so a separate --user-data-dir is required.)
# Leave blank to use the default http://127.0.0.1:9222, or the browser the "Open Browser" button starts.
BROWSER_CDP_ENDPOINT=
DEFAULT_LISTING_LIMIT=50

# --- CSV storage ---
CSV_STORAGE_DIR=./storage/csv

# --- Where the browser runs ---
# "attach" (default): drive your own Chrome over CDP — keeps your logged-in session. Local only.
# "launch": the backend starts its own browser. Required on a hosted server, but then there is no
# logged-in session, so credentials must be supplied above and CAPTCHA/OTP cannot be solved.
BROWSER_MODE=attach
